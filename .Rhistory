#| label: arithmetic-operator-examples
# Use operators with values only
5 + 6
5 ^ 6
5 ** 6
# Define variables
var1 <- 2
var2 <- 8
# Use operators with vars only
var2 / var1
var1 - var2
# mix it up
var1 + 5
# mix it up
var1 * 5
var2 + 6
# mix it up
var1 * 5 # 2 x 5
var2 + 6 # 8 + 6
# Decimal division
var1 / var2
#| label: integer-division-examples
var1 <- 10
var2 <- 3
# Decimal division
var1 / var2
# Integer division
var1 %/% var2
# Modulus
var1 %% var2
# Integer division
var1 %/% var2
# Decimal division
var1 / var2
var2 <- 7
# Decimal division
var1 / var2
# Integer division
var1 %/% var2
# Modulus
var1 %% var2 # 10 - (7 x 1)
# Integer division
var1 %/% var2
# Modulus
var1 %% var2 # 10 - (7 x 1)
#| label: integer-division-examples
var1 <- 15
var2 <- 7
# Decimal division
var1 / var2
# Modulus
var1 %% var2 # 15 - (7 x 2)
# Integer division
var1 %/% var2
# Modulus
var1 %% var2 # 15 - (7 x 2)
#| label: plot_tab_example
# Lets create a little plot
# create some data
data <- data.frame(a = c(72,41,54,36), b=c('East','West','North','South'))
# generate plot
barplot(data$a,
names.arg = data$b,
col="blue",
ylab="# of Regional Managers")
